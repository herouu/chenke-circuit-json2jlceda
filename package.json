{
  "name": "chenke-circuit-json2jlceda",
  "version": "0.1.0",
  "description": "将 tscircuit circuit-json 转换为嘉立创EDA专业版 (EasyEDA Pro) V2 .epro 工程文件",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "chenke-circuit-json2jlceda": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsup",
    "prepublishOnly": "tsup",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "keywords": [
    "tscircuit",
    "circuit-json",
    "easyeda",
    "lceda",
    "嘉立创eda",
    "epro"
  ],
  "license": "MIT",
  "author": "herouu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herouu/chenke-circuit-json2jlceda.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tscircuit/circuit-json-util": "^0.0.113",
    "circuit-json": "^0.0.491",
    "commander": "^15.0.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/herouu/chenke-circuit-json2jlceda/issues"
  },
  "homepage": "https://github.com/herouu/chenke-circuit-json2jlceda#readme"
}
